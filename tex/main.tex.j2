\newcommand{\AnswerLabelCell}[2]{%
  \parbox[c][#2][c]{\AnswerLabelWidth}{\centering\AnswerLabelFont #1}%
}

\newcommand{\AnswerBodyCell}[1]{%
  \parbox[c][#1][c]{\linewidth}{}%
}

\newcommand{\AnswerRow}[2]{%
  \AnswerLabelCell{#1}{#2} & \AnswerBodyCell{#2} \\
  \hline
}

% Post-processing row for user-supplied, approved prompt-side images.
% Keep the original row height, leave at least 0.6mm on all four sides of the
% image canvas, and shift it from the answer-cell center to the A4 page center.
\newcommand{\AnswerImageRow}[3]{%
  \AnswerLabelCell{#1}{#2} &%
  \parbox[c][#2][c]{\linewidth}{%
    \makebox[\linewidth][c]{%
      \hspace*{-\AnswerImagePageCenterShift}%
      \makebox[0pt][c]{%
        \includegraphics[%
          width=\dimexpr\linewidth-2\AnswerImagePageCenterShift-1.2mm\relax,%
          height=\dimexpr#2-1.2mm\relax,%
          keepaspectratio
        ]{\detokenize{#3}}%
      }%
      \hspace*{\AnswerImagePageCenterShift}%
    }%
  } \\
  \hline
}

% Deterministic approved special placement: repeat one approved clean asset in
% a single horizontal row. The caller supplies the audited count, gap, total
% gap and repeated graphics body.
\newcommand{\AnswerImageRepeatGraphic}[2]{%
  \includegraphics[%
    width=\AnswerImageSlotWidth,%
    height=\dimexpr#2-1.2mm\relax,%
    keepaspectratio
  ]{\detokenize{#1}}%
}

\newcommand{\AnswerImageRepeatRow}[6]{%
  \AnswerLabelCell{#1}{#2} &%
  \parbox[c][#2][c]{\linewidth}{%
    \setlength{\AnswerImageSlotWidth}{\dimexpr\linewidth-2\AnswerImagePageCenterShift-1.2mm-#5\relax}%
    \divide\AnswerImageSlotWidth by #3%
    \makebox[\linewidth][c]{%
      \hspace*{-\AnswerImagePageCenterShift}%
      \makebox[0pt][c]{#6}%
      \hspace*{\AnswerImagePageCenterShift}%
    }%
  } \\
  \hline
}

% Approved anchored placements. #4 is the audited fraction of the answer-row
% height and #5 is the minimum edge clearance.
\newcommand{\AnswerImageTopRightRow}[5]{%
  \AnswerLabelCell{#1}{#2} &%
  \setlength{\AnswerImageScaledHeight}{#4\dimexpr#2\relax}%
  \parbox[t][#2][t]{\linewidth}{\makebox[\linewidth][r]{%
    \includegraphics[width=\dimexpr\linewidth-2#5\relax,height=\AnswerImageScaledHeight,keepaspectratio]{\detokenize{#3}}\hspace*{#5}}} \\
  \hline
}

\newcommand{\AnswerImageBottomCenterRow}[5]{%
  \AnswerLabelCell{#1}{#2} &%
  \setlength{\AnswerImageScaledHeight}{#4\dimexpr#2\relax}%
  \parbox[c][#2][c]{\linewidth}{\vspace*{\fill}\makebox[\linewidth][c]{%
    \hspace*{-\AnswerImagePageCenterShift}%
    \includegraphics[width=\dimexpr\linewidth-2\AnswerImagePageCenterShift-2#5\relax,height=\AnswerImageScaledHeight,keepaspectratio]{\detokenize{#3}}%
    \hspace*{\AnswerImagePageCenterShift}}\vspace*{#5}} \\
  \hline
}

