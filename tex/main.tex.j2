\AnswerImageRepeatGraphic{((( image_binding.asset_path )))}{((( planned_block.height )))}((* if not loop.last *))\hspace{((( image_binding.gap_mm )))}mm((* endif *))%
((* endfor *))
}
((* elif image_binding and image_binding.mode == "top_right" *))
\AnswerImageTopRightRow{((( planned_block.block.id | latex_escape )))}{((( planned_block.height )))}{((( image_binding.asset_path )))}{((( image_binding.height_ratio )))}{((( image_binding.clearance_mm )))mm}
((* elif image_binding and image_binding.mode == "bottom_center" *))
\AnswerImageBottomCenterRow{((( planned_block.block.id | latex_escape )))}{((( planned_block.height )))}{((( image_binding.asset_path )))}{((( image_binding.height_ratio )))}{((( image_binding.clearance_mm )))mm}
((* elif image_binding *))
\AnswerImageRow{((( planned_block.block.id | latex_escape )))}{((( planned_block.height )))}{((( image_binding.asset_path )))}
((* else *))
\AnswerRow{((( planned_block.block.id | latex_escape )))}{((( planned_block.height )))}
((* endif *))
((* endfor *))
\AnswerTableEnd
((* endfor *))
((* endfor *))

